# ============================================================
# Environment variables for Node 1 RAG Agent ("Ask Ayush")
# ============================================================
# Copy this file to .env.local and fill in real values.
# .env.local is listed in .gitignore — never commit real secrets.
# ============================================================

# ----------------------------------------------------------
# Database — SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix)
# ----------------------------------------------------------
# These are never exposed to the browser.

# Your Neon Postgres connection string
DATABASE_URL=postgres://user:password@ep-cool-darkness-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ----------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------
# HMAC secret for hashing IP addresses before storing as
# rate-limit identifiers (never store raw IPs).
# Generate with: openssl rand -hex 32
RATE_LIMIT_HMAC_SECRET=your-32-byte-hex-secret-here

# Per-IP: max requests allowed per window
RATE_LIMIT_PER_IP_MAX=10

# Per-IP: window duration in seconds (3600 = 1 hour)
RATE_LIMIT_PER_IP_WINDOW_SECONDS=3600

# Global daily cost guard: max total requests per day
RATE_LIMIT_GLOBAL_MAX=100

# Global window in seconds (86400 = 24 hours)
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=86400

# ----------------------------------------------------------
# Groq LLM — SERVER-SIDE ONLY
# ----------------------------------------------------------
GROQ_API_KEY=your-groq-api-key-here

# ----------------------------------------------------------
# Notes
# ----------------------------------------------------------
# DATABASE_URL is the most critical secret. If it leaks, 
# rotate the password in the Neon dashboard immediately.
#
# The Groq API key can be rotated at console.groq.com.
#
# Do not add NEXT_PUBLIC_ versions of any secret above.
